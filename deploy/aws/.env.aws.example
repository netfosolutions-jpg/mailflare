# Copy to .env.aws and edit, then `docker compose -f docker-compose.aws.yml up -d --build`:
#   cp .env.aws.example .env.aws
#
# Loaded by docker-compose.aws.yml (env_file). See docs/self-hosting.md for
# the full reference.

# ===== Basics =====
# Public HTTPS address served by Caddy; links, the JMAP session and webhooks use it.
APP_URL=https://mail.netfo.co

# ===== Inbound mail =====
# Host the MX records of both domains point at; also the SMTP banner name.
MAIL_HOSTNAME=mail.netfo.co
# Built-in SMTP listener port inside the container (mapped to host port 25).
SMTP_INBOUND_PORT=25

# ===== Outbound mail (Amazon SES over SMTP) =====
# SES SMTP credentials (not the IAM access keys) and the SES region endpoint.
SMTP_URL=smtps://SES_SMTP_USER:SES_SMTP_PASSWORD@email-smtp.REGION.amazonaws.com:465

# ===== Blob storage (S3) =====
# Private bucket for raw mail, attachments, Drive files, avatars, branding and backups.
S3_BUCKET=
# Region the bucket lives in, for example eu-west-1.
S3_REGION=
# Access key of the IAM user that has the policy from iam-policy.json.
S3_ACCESS_KEY_ID=
# Secret for that access key.
S3_SECRET_ACCESS_KEY=

# ===== Optional =====
# Web Push keys (generate with `npx web-push generate-vapid-keys`) and contact.
#VAPID_PRIVATE_KEY=
#VAPID_PUBLIC_KEY=
#VAPID_SUBJECT=mailto:admin@netfo.co

# Email assistant (OpenAI-compatible API).
#AI_BASE_URL=
#AI_API_KEY=
#AI_MODEL=gpt-4o-mini
